# WHMCS API — Setup > Staff Management > Manage API Credentials
WHMCS_API_URL=https://billing.domainanda.com/includes/api.php
WHMCS_IDENTIFIER=
WHMCS_SECRET=
# Kosongkan untuk mata uang default WHMCS (IDR)
WHMCS_CURRENCY_ID=

# Telegram — buat bot via @BotFather, chat_id grup biasanya diawali "-100"
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Opsional: ID topik untuk grup forum (link https://t.me/c/<chat>/<topik> → isi <topik>)
TELEGRAM_THREAD_ID=

# Rumus: ROUNDUP(reseller × (1 + PPN + MARGIN), -3)
PPN_PERCENT=11
MARGIN_PERCENT=3

# Interval cek untuk mode --loop (Docker), default 6 jam
INTERVAL_MINUTES=360

# Hanya untuk run tanpa Docker; di Docker state disimpan di volume /data
# STATE_FILE=state.json
