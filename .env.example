# Kredensial API WHMCS, dibuat di System Settings > Manage API Credentials
WHMCS_API_URL=https://billing.domainanda.com/includes/api.php
WHMCS_IDENTIFIER=
WHMCS_SECRET=
# Kosongkan untuk mata uang default WHMCS (IDR)
WHMCS_CURRENCY_ID=

# Token dari @BotFather. Chat ID grup biasanya diawali "-100"
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Opsional, untuk grup forum: dari link https://t.me/c/<chat>/<topik>, isi angka <topik>
TELEGRAM_THREAD_ID=

# Rumus: ROUNDUP(reseller × (1 + PPN + MARGIN), -3)
PPN_PERCENT=11
MARGIN_PERCENT=3

# Opsional: item promo yang sengaja dijual di bawah rumus, format tld:aksi dipisah koma.
# Aksi: register, renew, atau transfer. Contoh: PROMO=my.id:register,biz.id:register
PROMO=

# Domain gTLD (harga USD). Kurs live diambil dari open.er-api.com
GTLD_ENABLED=true
# Harga jual gTLD dibulatkan ke atas ke kelipatan ini (Rupiah)
GTLD_ROUND_TO=500
# Kurs live dibulatkan ke atas ke kelipatan ini, supaya harga tidak berubah setiap hari.
# Isi 1 untuk mengikuti kurs live hampir persis
USD_RATE_ROUND_TO=100

# Zona waktu untuk jam di log (nama IANA)
TZ=Asia/Jakarta

# Jarak antar-pengecekan dalam menit untuk mode --loop (Docker). 360 = 6 jam
INTERVAL_MINUTES=360

# Hanya untuk jalan tanpa Docker. Di Docker, state disimpan di volume /data
# STATE_FILE=state.json
